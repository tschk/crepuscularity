[package]
name = "crepus_mobile_actions"
version = "0.1.0"
edition = "2021"

[workspace]

[lib]
crate-type = ["staticlib", "cdylib", "rlib"]

[features]
default = []
filesystem = []

[dependencies]
libc = "0.2"
serde_json = { version = "1", features = ["float_roundtrip"] }

[target.'cfg(target_os = "android")'.dependencies]
jni = "0.21"
